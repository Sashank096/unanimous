# Copy this file to .env and fill in your real values.
# Get these from Supabase: Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key

# Any random long string — used to sign the Flask session cookie.
SECRET_KEY=change-this-to-something-random

# Public deployment URL used in portfolio share links.
# Local development can use the production URL below; replace it with your
# custom domain when you connect one.
PUBLIC_APP_URL=https://your-project.vercel.app

# Free, no credit card — get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Resend Send Email Hook (Supabase Edge Function).
# Configure these as Supabase Edge Function secrets, not Flask environment
# variables. Set RESEND_FROM_EMAIL to an address on a verified Resend domain.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Your App <auth@your-verified-domain.com>
